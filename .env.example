# Copy to .env.local (not committed) and fill in. Next loads .env.local in both dev and prod.
# DATABASE_URL comes from .env.development / .env.production (committed, local Docker only).

# --- Tailored CV: which AI CLI rewrites it ---
# gemini (default) or claude.
# CV_AI_PROVIDER=gemini

# --- Gemini CLI (npm i -g @google/gemini-cli) ---
# API key from https://aistudio.google.com/apikey. Leave unset if you logged in with Google in the CLI.
GEMINI_API_KEY=
# Primary model (fast).
# GEMINI_MODEL=gemini-3.5-flash-lite
# Used when the primary fails or times out; empty = CLI default (stronger, but often overloaded and slow).
# GEMINI_FALLBACK_MODEL=
# How long to wait for the primary model before falling back (ms).
# GEMINI_TIMEOUT_MS=180000
# GEMINI_BIN=gemini

# --- Claude Code CLI (npm i -g @anthropic-ai/claude-code; run `claude` once to log in) ---
# Uses your Claude login (Pro/Max). Setting ANTHROPIC_API_KEY here makes the CLI bill the API key instead.
# Alias (sonnet, opus, haiku) or full model id.
# CLAUDE_MODEL=sonnet
# Used when the primary fails or times out; empty = no fallback.
# CLAUDE_FALLBACK_MODEL=haiku
# CLAUDE_TIMEOUT_MS=300000
# CLAUDE_BIN=claude

# Folder with your CVs (cv-en.md, cv-pt.md, PDFs). Tailored PDFs are saved in <CV_DIR>/aplicacoes/.
# CV_DIR=./cv
# WKHTMLTOPDF_BIN=wkhtmltopdf
